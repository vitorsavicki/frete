{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frete",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frete",
      "database_id": "77a441f6-2e58-467b-b47f-76a131fc702a",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "EMAIL_FROM": "Quero Mudar Já <onboarding@resend.dev>"
  },
  "observability": {
    "enabled": true
  }
}
