{
  "name": "frete",
  "version": "2.0.0",
  "private": true,
  "description": "Quero Mudar Já v2 — site de mudanças e fretes em que os caminhoneiros enviam seus próprios orçamentos. Cloudflare Workers + Hono + D1.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply frete --local",
    "db:migrate": "wrangler d1 migrations apply frete --remote",
    "db:seed:local": "wrangler d1 execute frete --local --file=seed.sql",
    "db:seed": "wrangler d1 execute frete --remote --file=seed.sql",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "leaflet": "^1.9.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "workerd@1.20250906.0": true,
    "workerd@1.20261019.1": true
  }
}
